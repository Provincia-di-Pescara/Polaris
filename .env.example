# POLARIS — Esempio configurazione
# Copia questo file in .env e adatta i valori al tuo ambiente.
# Non committare mai .env con credenziali reali nel repository!
#
# Qui vivono SOLO le variabili sistemistiche/di bootstrap. SMTP, OIDC (issuer,
# client_id, client_secret), branding e i coefficienti dell'allegato parametrico
# si configurano dalla UI admin (menu Impostazioni) e sono persistiti nel DB —
# vedi impostazioni_sistema / parametrico_versioni in CLAUDE.md.

# ── Compose ───────────────────────────────────────────────────────────────────
# SOLO SVILUPPO: attiva l'override con bind mount e hot-reload.
# Windows usa ";" come separatore, Linux/macOS usa ":".
# In produzione NON impostare questa variabile.
#COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml

# Tag delle immagini di produzione (es. v0.5.0). Default: latest.
IMAGE_TAG=latest

# ── Porte host ────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
ENGINE_PORT=8081
FRONTEND_PUBBLICO_PORT=8082
FRONTEND_BACKOFFICE_PORT=8083
# SOLO SVILUPPO (docker-compose.override.yml): porte del server Vite dentro i
# container dev, distinte da quelle sopra (che restano quelle di nginx in prod —
# vedi commento in docker-compose.override.yml sul perché non si può riusare la
# stessa variabile).
FRONTEND_PUBBLICO_DEV_PORT=5174
FRONTEND_BACKOFFICE_DEV_PORT=5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Il compose costruisce da sé DATABASE_URL: servono solo questi.
# ATTENZIONE: la password finisce dentro DATABASE_URL senza escaping.
# Usa SOLO caratteri alfanumerici (niente $ @ # ^ / : %), es. openssl rand -hex 24
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris_dev_password
POSTGRES_DB=polaris_db

# ── SMTP di bootstrap (wizard primo avvio) ───────────────────────────────────
# Usato SOLO per l'email di attivazione del primo account admin: al primo avvio
# non esiste ancora nessun admin che possa configurare l'SMTP da UI. Con
# SMTP_HOST vuoto l'endpoint di bootstrap risponde 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=polaris@example.org
# URL pubblico del frontend backoffice, base del link di attivazione nella email.
BACKOFFICE_BASE_URL=http://localhost:5173

# ── Backup ────────────────────────────────────────────────────────────────────
# Default dell'immagine (prodrigestivill/postgres-backup-local): giornaliero,
# 7gg + 4 settimane + 6 mesi di rotazione. Vedi docs/RUNBOOK-backup.md per il restore.
#BACKUP_SCHEDULE=@daily
#BACKUP_KEEP_DAYS=7
#BACKUP_KEEP_WEEKS=4
#BACKUP_KEEP_MONTHS=6

# ── Secret ────────────────────────────────────────────────────────────────────
# OBBLIGATORIO in produzione. Genera con: openssl rand -hex 32
# JWT_SECRET firma i token (backoffice E pubblico, audience diverse — vedi
# CLAUDE.md) E deriva la chiave di cifratura del client_secret OIDC salvato
# in DB: se lo cambi, il client_secret salvato va reinserito da UI.
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ── Hardening (opzionali, nessun default abilitato) ──────────────────────────
# Origini consentite per le richieste cross-site (CORS), separate da virgola.
# Vuoto/assente = nessuna origine cross-site esplicitamente permessa.
# Esempio: CORS_ALLOWED_ORIGINS=https://backoffice.esempio.it,https://pubblico.esempio.it
# ATTENZIONE: le origini elencate devono essere same-site rispetto all'API
# (stesso registrable domain, es. sottodomini) — il cookie di stato del login
# OIDC pubblico (SameSite=Lax) non viene allegato dal browser su richieste
# cross-site, e il login SPID/CIE fallirebbe con 401 "sessione di login non
# riconosciuta" senza indizio evidente della causa.
CORS_ALLOWED_ORIGINS=

# Da impostare SOLO quando il reverse proxy esterno (gestito fuori da questo
# repo) è effettivamente davanti al backend — altrimenti req.ip e i rate
# limiter leggerebbero l'IP del proxy invece di quello del client reale.
# Valori accettati: quelli di Express (es. 'loopback', un numero di hop, un IP/subnet).
# NOTA: 'true'/'false' letterali NON sono valori validi qui (a differenza di
# Express in generale) — express-rate-limit v8 rifiuta esplicitamente
# trust proxy=true come "permissivo" (ERR_ERL_PERMISSIVE_TRUST_PROXY), e il
# backend rifiuta questi due valori al boot con un errore leggibile.
TRUST_PROXY=

# ── Storage documenti ─────────────────────────────────────────────────────────
# Path interno al container dove il backend salva i documenti caricati dagli utenti
# (statuti, atti costitutivi — vedi docs/superpowers/specs/2026-07-30-accreditamento-delega-design.md).
# Volume named, mai bind mount in produzione.
DOCUMENTI_STORAGE_PATH=/data/documenti
