# POLARIS — Aggiunte SOLO SVILUPPO (docker-compose.override.yml)
#
# Non è un file autonomo: contiene solo le variabili che si aggiungono a quelle
# di .env.example per lo sviluppo locale via Docker. Per usarlo:
#   cat .env.example .env.dev.example > .env
# poi adatta i valori (IMAGE_TAG qui non serve: le immagini dev si buildano in
# locale da Dockerfile.dev, non si scaricano da GHCR).

# Attiva l'override con bind mount/hot-reload — build locale da Dockerfile.dev
# invece che pull da GHCR. Windows usa ";" come separatore, Linux/macOS ":".
COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml

# Porta host di "engine" — solo l'override la pubblica (in produzione "engine"
# resta sempre puramente interno, nessuna porta).
ENGINE_PORT=8081

# Porte del server Vite dentro i container dev, DISTINTE da FRONTEND_*_PORT
# (quelle restano di nginx anche quando l'override è attivo — "ports" si
# concatena tra file compose, non si sostituisce, vedi il commento in
# docker-compose.override.yml).
FRONTEND_PUBBLICO_DEV_PORT=5174
FRONTEND_BACKOFFICE_DEV_PORT=5173
